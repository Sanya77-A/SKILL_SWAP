# Server (the hosting platform normally injects PORT)
PORT=5003
NODE_ENV=development

# Database mode: mongo uses durable persistence; demo is isolated and read-only.
DATABASE_MODE=mongo
# Required only when DATABASE_MODE=mongo.
MONGO_URI=mongodb://localhost:27017/skillswap
MONGO_MAX_POOL_SIZE=10

# Optional demo seed controls
SEED_DEMO_PASSWORD=replace-with-a-local-demo-password
ALLOW_PRODUCTION_SEED=false

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
AUTH_EXPOSE_ACCESS_TOKEN=false
ANALYTICS_SALT=replace-with-a-separate-random-value-min-32-chars
# Optional. When unset, scheduled processing is disabled and the cron route returns 503.
CRON_SECRET=replace-with-a-random-value-min-16-chars
LOG_LEVEL=info

# Exact client origin (for CORS, CSRF, Socket.IO, and password reset links)
# Local development:
CLIENT_URL=http://localhost:5174
# Production:
# CLIENT_URL=https://skillswap-nine-jet.vercel.app

# Cloudinary (optional; configure all three to enable durable production uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkillSwap <noreply@skillswap.com>

# AI (optional; disabled means no provider calls are made)
AI_PROVIDER=disabled
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
