# Optional backend origin override. Production defaults to same-origin /api for
# the single-project Vercel deployment.
#
# Local development example (backend currently runs on port 5003):
# VITE_API_URL=http://localhost:5003
#
# Vercel production: leave VITE_API_URL unset.
#
# Optional only when a separately deployed, production-ready realtime service
# exists. When unset in production, Socket.IO is disabled and chat polls REST.
# VITE_SOCKET_URL=https://your-realtime.example.com
